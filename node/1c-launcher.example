#!/bin/sh
# Пример обёртки запуска 1С для пула «опубликованное приложение».
# Положить на узлы пула как /usr/local/bin/1c-buh (chmod 0755), для Документооборота —
# копию /usr/local/bin/1c-doc со своей базой. В [pools.profile] брокера:
#   command = "/usr/local/bin/1c-buh"
#   rootless = true
#
# Версию платформы берём самую новую из установленных, чтобы обновление 1С
# не требовало правки обёртки. Строку подключения поменяйте на свою:
#   клиент-серверная база:  /S"сервер-1с\имя-базы"
#   файловая база:          /F"/mnt/1c/buh"

SERVER_DB='srv-1c.rrcki.ru\buh'

BIN=$(ls -d /opt/1cv8/x86_64/*/1cv8c 2>/dev/null | sort -V | tail -n 1)
if [ -z "$BIN" ]; then
    echo "Тонкий клиент 1С не найден в /opt/1cv8" >&2
    exit 1
fi

# Когда пользователь закрывает 1С, сессия X2Go завершается вместе с ней.
exec "$BIN" ENTERPRISE /S"$SERVER_DB" /DisableStartupMessages
